# Server Configuration
PORT=5001

# MongoDB Connection String (Local or MongoDB Atlas)
# For Local MongoDB: mongodb://127.0.0.1:27017/contactx
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/contactx?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/contactx

# JWT Secret for User Authentication Tokens
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
