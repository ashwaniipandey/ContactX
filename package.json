{
  "name": "contactx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "backend": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend start",
    "backend:install": "npm --prefix backend install",
    "dev:all": "concurrently -n \"Frontend,Backend\" -c \"cyan,magenta\" \"npm run dev\" \"npm run backend\""
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
